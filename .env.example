# ===========================================================================
# SoloDesk Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-minimum-32-chars

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
#
# The host differs by where the app runs — this is the single most common
# setup mistake:
#   - app on your machine, DB in Docker  →  localhost
#   - app inside compose (api/worker/beat/migrate)  →  postgres  (service name)
# Deploy environments always use the service name. `.env` is read by every
# service, so one wrong host here breaks the whole stack at once.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://solodesk:solodesk@localhost:5432/solodesk
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Credentials the postgres container is created with. These MUST match the
# user / password / database embedded in DATABASE_URL above — Postgres only
# applies them when the data volume is first initialised, so changing them
# later has no effect until the volume is recreated.
POSTGRES_USER=solodesk
POSTGRES_PASSWORD=solodesk
POSTGRES_DB=solodesk

# ---------------------------------------------------------------------------
# Redis  (host: localhost from your machine, `redis` from inside compose)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Celery — separate Redis databases keep the broker, results and cache apart
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Google Services
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Legacy OAuth 2.0 credentials (pre-platform-split layout) — kept for rollback:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# GROQ
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# ---------------------------------------------------------------------------
# Groq (lead qualifier)
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PLAN_PRICE_ID=

# ---------------------------------------------------------------------------
# MoMo (AIOv2 sandbox) — https://developers.momo.vn/v2/#/docs/aiov2
# Defaults (in src/config/settings.py) are MoMo's published sandbox
# test-merchant credentials; override here only if using a personal test merchant.
# ---------------------------------------------------------------------------
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PARTNER_NAME=
MOMO_STORE_ID=
MOMO_ENDPOINT=
MOMO_REQUEST_TYPE=
MOMO_IPN_URL=
MOMO_REDIRECT_URL=

# ---------------------------------------------------------------------------
# Object Storage (S3-compatible)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=solodesk-uploads
STORAGE_ACCESS_KEY=solodesk
STORAGE_SECRET_KEY=solodesk123
STORAGE_REGION=ap-southeast-1

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@solodesk.app
SMTP_FROM_NAME=SoloDesk
SMTP_TLS=false

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Backend dựng link TRONG THƯ GỬI KHÁCH từ biến này (email báo deal mới từ intake form,
# thư nhắc gói dịch vụ), và chuyển hướng về đây sau các luồng OAuth ngoài (Zalo).
# Khi deploy mà quên đặt là gửi cho khách một đường dẫn localhost chết.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Zalo Official Account
# ---------------------------------------------------------------------------
# `mock` chạy tất định, KHÔNG gọi mạng — để nguyên khi dev local.
#
# `real` KHÔNG chạy được trên localhost hay ngrok: Zalo từ chối redirect với
# `-14003 Invalid redirect uri` vì không tin domain tạm. Chỉ bật real trên domain thật
# đã khai trong "Miền ứng dụng" + đã "Xác thực domain" ở Zalo Developers.
ZALO_MODE=mock
ZALO_APP_ID=
ZALO_APP_SECRET=
# Phải khớp TỪNG KÝ TỰ với Redirect URI khai trên Zalo Developers.
ZALO_OAUTH_REDIRECT_URI=
# Chưa dùng: webhook thật xác thực chữ ký bằng ZALO_APP_SECRET (xem modules/zalo/api/router.py).
ZALO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Logging — behavior driven by APP_ENV (dev=console/DEBUG, staging+prod=json/INFO)
# ---------------------------------------------------------------------------
LOG_LEVEL=            # optional override: DEBUG|INFO|WARNING|ERROR|CRITICAL (prod clamps ≥INFO)
LOG_FORMAT=           # optional override: console|json
SERVICE_NAME=solodesk-api
LOG_REQUEST_BODY=false  # debug only, forced OFF in production